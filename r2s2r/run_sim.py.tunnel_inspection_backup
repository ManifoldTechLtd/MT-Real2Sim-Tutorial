def update_follow_camera():
    try:
        mat = get_pose()
        if mat is None:
            return

        px, py, pz = mat[0, 3], mat[1, 3], mat[2, 3]

        import omni.kit.viewport.utility as vp
        viewport = vp.get_active_viewport()

        viewport.set_camera_position(
            "/OmniverseKit_Persp",
            px + 3.0,
            py - 3.0,
            pz + 2.0,
            False
        )

        viewport.set_camera_target(
            "/OmniverseKit_Persp",
            px,
            py,
            pz + 0.3,
            False
        )

    except Exception:
        pass


# =========================================================
# 13. bridge publish
# =========================================================
# 各数据流独立节流, 频率从 config 读取
_pose_dt = 1.0 / float(bridge_cfg.get("pose_rate", 50))
_pc_dt = 1.0 / float(bridge_cfg.get("pointcloud_rate", 5))
_img_dt = 1.0 / float(bridge_cfg.get("image_rate", 10))
_imu_dt = 1.0 / float(bridge_cfg.get("imu_rate", 50))
_img_quality = int(bridge_cfg.get("image_quality", 80))

_last_pose_pub = 0.0
_last_pc_pub = 0.0
_last_img_pub = 0.0
_last_imu_pub = 0.0
_pc_diag_count = 0   # 点云帧计数 (诊断用)
_img_diag_count = 0  # 图像帧计数 (诊断用)
_imu_diag_count = 0  # IMU 帧计数 (诊断用)

# ---- lidar self-filter (履带车专用, 详见 kinematic_car.yaml) ----
# 履带车 chassis_visual cube 被 RTX Lidar 光追打回的自身回波在 lidar 局部系是常量盒,
# 用 numpy mask 整盒剔除. pose-invariant (chassis 与 lidar 同挂 base_link).
_self_filter_enabled = False
_self_filter_bounds = None  # (x_half, y_half, z_min, z_max)
if robot_type == "kinematic_car":
    _sf_cfg = config.get("kinematic_car", {}).get("lidar_self_filter", {})
    if bool(_sf_cfg.get("enable", True)):
        _self_filter_enabled = True
        _self_filter_bounds = (
            float(_sf_cfg.get("x_half", 0.60)),
            float(_sf_cfg.get("y_half", 0.45)),
            float(_sf_cfg.get("z_min", -0.55)),
            float(_sf_cfg.get("z_max", -0.10)),
        )
        print(f"[BOOT] lidar_self_filter ENABLED (lidar local) "
              f"bounds=|x|<{_self_filter_bounds[0]:.2f}, "
              f"|y|<{_self_filter_bounds[1]:.2f}, "
              f"z∈[{_self_filter_bounds[2]:.2f},{_self_filter_bounds[3]:.2f}]")


def _apply_lidar_self_filter(pc):
    """剔除 lidar 局部系 bbox 内的 self-scan 点 (chassis_visual 回波)."""
    if not _self_filter_enabled or _self_filter_bounds is None or len(pc) == 0:
        return pc
    xh, yh, zmin, zmax = _self_filter_bounds
    x, y, z = pc[:, 0], pc[:, 1], pc[:, 2]
    keep = ~((np.abs(x) < xh) & (np.abs(y) < yh) & (z > zmin) & (z < zmax))
    return pc[keep]


def publish():
    """主循环每物理步调用一次, 内部按各自频率节流"""
    global _last_pose_pub, _last_pc_pub, _last_img_pub, _last_imu_pub
    global _pc_diag_count, _img_diag_count, _imu_diag_count

    now = time.time()

    # ---- pose @ pose_rate (默认 50Hz) ----
    # 仿真中 odin1_base_link ≡ body link, 与真机几何不完全一致但拓扑对齐;
    # k02_nav 静态 TF (odin1_base_link→base_footprint, z=-0.5162) 让
    # base_footprint 落在地面附近 (Spot body 站立 z≈0.5m).
    if now - _last_pose_pub >= _pose_dt:
        mat = get_pose()
        if mat is not None:
            x, y, z = mat[0, 3], mat[1, 3], mat[2, 3]
            qx, qy, qz, qw = mat_to_quat(mat[:3, :3])
            bridge.send_pose(
                x, y, z,
                qx, qy, qz, qw,
                vx=float(cmd[0]),
                vy=float(cmd[1]),
                wz=float(cmd[2]),
                timestamp=now,
            )
        _last_pose_pub = now

    # ---- pointcloud @ pointcloud_rate (默认 5Hz) ----
    # frame_id="lidar1" (lidar local frame), 由 bridge_node 静态 TF
    # odin1_base_link → lidar1 [0,0,0.8] 表达物理位置.
    # k02_nav pointcloud_to_laserscan target_frame=odin1_base_link 通过 TF 自动转换.
    if suite is not None and now - _last_pc_pub >= _pc_dt:
        try:
            lidar_data = suite.get_data_by_type("lidar")
            for name, sd in lidar_data.items():
                if "error" in sd:
                    continue
                pc = sd.get("point_cloud")
                if pc is not None and len(pc) > 0:
                    n_raw = len(pc)
                    pc = _apply_lidar_self_filter(pc)
                    if len(pc) == 0:
                        continue
                    bridge.send_pointcloud(pc, frame_id="lidar1",
                                           timestamp=now)
                    _pc_diag_count += 1
                    if _pc_diag_count <= 3 or _pc_diag_count % 50 == 0:
                        n_drop = n_raw - len(pc)
                        print(f"[PUB] pointcloud #{_pc_diag_count}: "
                              f"sensor='{name}', n_points={len(pc)} "
                              f"(self_filter dropped {n_drop}/{n_raw})")
                    break  # 只发第一台 lidar
        except Exception as e:
            print("[PUB WARN] lidar:", e)
        _last_pc_pub = now

    # ---- image @ image_rate (默认 10Hz) ----
    # frame_id="camera1", 由 bridge_node 静态 TF 连到 odin1_base_link.
    # (k02_nav 实际不通过 TF 转换 image, 此 frame_id 仅用于 RViz 显示)
    if suite is not None and now - _last_img_pub >= _img_dt:
        try:
            cam_data = suite.get_data_by_type("camera")
            for name, sd in cam_data.items():
                if "error" in sd:
                    continue
                rgb = sd.get("rgb")
                if rgb is not None and rgb.size > 0:
                    bridge.send_image(rgb, frame_id="camera1",
                                      quality=_img_quality, timestamp=now)
                    _img_diag_count += 1
                    if _img_diag_count <= 3 or _img_diag_count % 100 == 0:
                        print(f"[PUB] image #{_img_diag_count}: "
                              f"sensor='{name}', shape={rgb.shape}")
                    break
        except Exception as e:
            print("[PUB WARN] camera:", e)
        _last_img_pub = now

    # ---- imu @ imu_rate (默认 50Hz) ----
    # 真机 frame_id="imu_link" (host_sdk_sample.h:249).
    # 由 bridge_node 静态 TF odin1_base_link → imu_link [0,0,0.5] 表达 rimu 安装位置.
    if suite is not None and now - _last_imu_pub >= _imu_dt:
        try:
            imu_data = suite.get_data_by_type("imu")
            for name, sd in imu_data.items():
                if "error" in sd:
                    continue
                lin_acc = sd.get("lin_acc")
                ang_vel = sd.get("ang_vel")
                if lin_acc is not None and ang_vel is not None:
                    bridge.send_imu(
                        lin_acc, ang_vel,
                        orientation=sd.get("orientation"),
                        frame_id="imu_link",
                        timestamp=now,
                    )
                    _imu_diag_count += 1
                    if _imu_diag_count <= 3 or _imu_diag_count % 500 == 0:
                        print(f"[PUB] imu #{_imu_diag_count}: "
                              f"sensor='{name}', |a|={float(np.linalg.norm(lin_acc)):.2f}, "
                              f"|w|={float(np.linalg.norm(ang_vel)):.3f}")
                    break
        except Exception as e:
            print("[PUB WARN] imu:", e)
        _last_imu_pub = now


# =========================================================
# 14. main
# =========================================================
def main():

    bridge.start()

    # reset first
    world.reset()

    # robot init after reset
    robot.initialize()

    # sensors init after physics exists
    if suite:
        suite.initialize()

    setup_keyboard()
    set_camera_static()

    # 预热几帧（修 RTX LiDAR）
    for _ in range(30):
        simulation_app.update()

    # callback after everything ready
    def on_physics_step(step_size):

        try:
            update_keyboard()
            robot.forward(step_size, cmd)
            publish()

        except Exception as e:
            print("[STEP WARN]", e)

    world.add_physics_callback("policy", on_physics_step)

    # play timeline
    timeline = omni.timeline.get_timeline_interface()
    timeline.play()
    world.play()

    print("=" * 60)
    print("[RUNNING]")
    print("WASD  move")
    print("Q/E   yaw")
    print("R     reset robot at current (x,y,yaw)")
    print("=" * 60)

    last_diag = time.time()

    while simulation_app.is_running():

        try:
            world.step(render=True)
            update_follow_camera()

        except Exception as e:
            print("[LOOP WARN]", e)

        if time.time() - last_diag > 5:
            print(
                f"[diag] cmd={cmd.round(2)} play={world.is_playing()}"
            )
            last_diag = time.time()


# =========================================================
# 15. shutdown
# =========================================================
try:
    main()

except KeyboardInterrupt:
    print("Ctrl+C")

finally:
    try:
        bridge.stop()
    except Exception:
        pass

    simulation_app.close()
    print("[EXIT]")