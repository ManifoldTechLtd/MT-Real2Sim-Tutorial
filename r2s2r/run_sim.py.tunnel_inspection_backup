# 必须保留为模块级变量, 否则 subscription handle 会被 GC, 回调失效
_kb_sub = None
_kb_input_iface = None
_kb_handle = None
_r_prev = False  # R 键边沿检测（避免长按重复触发原地复位）
_p_prev = False  # P 键边沿检测（回起点）

# 起点位姿: 来自 config.yaml quadruped.position. P 键复位时回到这里.
_START_XYZ = tuple(float(v) for v in quad_cfg.get("position", [0.0, 0.0, 0.5]))

def setup_keyboard():
    global _kb_sub, _kb_input_iface, _kb_handle
    try:
        _kb_input_iface = carb.input.acquire_input_interface()
        app_window = omni.appwindow.get_default_app_window()
        _kb_handle = app_window.get_keyboard()

        def cb(e, *args, **kwargs):
            try:
                if hasattr(e.input, "name"):
                    name = e.input.name
                else:
                    name = str(e.input)

                name = name.upper()

                if e.type == carb.input.KeyboardEventType.KEY_PRESS:
                    key_state[name] = True
                    print(f"[KB] press {name}")

                elif e.type == carb.input.KeyboardEventType.KEY_RELEASE:
                    key_state[name] = False

            except Exception as ex:
                print("[KB WARN]", ex)

            return True

        _kb_sub = _kb_input_iface.subscribe_to_keyboard_events(_kb_handle, cb)

        print(f"[BOOT] keyboard ready, sub={_kb_sub}")

    except Exception as e:
        print("[WARN] keyboard init fail:", e)


def reset_robot(to_start: bool = False):
    """复位机器人姿态.

    R 键 (to_start=False): 保留当前 (x, y, yaw), 抬升 z 避免穿模, pitch/roll 清零,
        关节回默认站立, 速度清零. 用于侧翻/卡障碍原地恢复.
    P 键 (to_start=True): 强制回到 config.yaml `quadruped.position` 起点, yaw=0,
        其余清零. 用于 NeuPAN 测试反复回原点.
    """
    try:
        pos, quat = robot.robot.get_world_pose()
        if pos is None or quat is None:
            print("[RESET] pose unavailable")
            return

        if to_start:
            sx, sy, sz = _START_XYZ
            x, y = sx, sy
            z = max(sz, 0.5)
            yaw = 0.0
        else:
            x, y, z = float(pos[0]), float(pos[1]), float(pos[2])
            # Isaac Sim quat order: (w, x, y, z)
            w, qx, qy, qz = float(quat[0]), float(quat[1]), float(quat[2]), float(quat[3])
            yaw = math.atan2(2.0 * (w * qz + qx * qy),
                             1.0 - 2.0 * (qy * qy + qz * qz))
            z = max(z, 0.5)

        new_quat = np.array(
            [math.cos(yaw / 2.0), 0.0, 0.0, math.sin(yaw / 2.0)],
            dtype=np.float64,
        )
        # 抬起到至少 0.5m，避免从地下/障碍内重生
        new_pos = np.array([x, y, z], dtype=np.float64)

        robot.robot.set_world_pose(new_pos, new_quat)
        robot.robot.set_linear_velocity(np.zeros(3))
        robot.robot.set_angular_velocity(np.zeros(3))

        if hasattr(robot, "default_pos") and robot.default_pos is not None:
            n_dof = len(robot.default_pos)
            try:
                robot.robot.set_joint_positions(robot.default_pos)
                robot.robot.set_joint_velocities(np.zeros(n_dof))
            except Exception as ex:
                # 部分 Articulation 需用 _articulation_view 调用
                try:
                    robot.robot._articulation_view.set_joint_positions(
                        robot.default_pos.reshape(1, -1)
                    )
                    robot.robot._articulation_view.set_joint_velocities(
                        np.zeros((1, n_dof))
                    )
                except Exception as ex2:
                    print(f"[RESET WARN] joint reset fallback failed: {ex2}")

        tag = "START" if to_start else "INPLACE"
        print(f"[RESET {tag}] pos=({x:.2f}, {y:.2f}, {new_pos[2]:.2f}) "
              f"yaw={math.degrees(yaw):.1f}deg")
    except Exception as e:
        print(f"[RESET WARN] {e}")


def update_keyboard():
    """合成 cmd: 键盘优先, 无按键时用 TCP /cmd_vel. R/P 键边沿触发复位."""
    global _r_prev, _p_prev

    # R 键: 原地复位 (保留 xy/yaw, 清姿态)
    r_now = key_state.get("R", False)
    if r_now and not _r_prev:
        reset_robot(to_start=False)
    _r_prev = r_now

    # P 键: 回起点 (xy/yaw 强制为 config 起点, yaw=0)
    p_now = key_state.get("P", False)
    if p_now and not _p_prev:
        reset_robot(to_start=True)
    _p_prev = p_now

    vx = vy = wz = 0.0

    if key_state.get("W", False):
        vx += KB_LINEAR
    if key_state.get("S", False):
        vx -= KB_LINEAR
    if key_state.get("A", False):
        vy += KB_LATERAL
    if key_state.get("D", False):
        vy -= KB_LATERAL
    if key_state.get("Q", False):
        wz += KB_YAW
    if key_state.get("E", False):
        wz -= KB_YAW

    # 键盘没动作时, fallback 到 TCP cmd_vel (来自 ROS /cmd_vel → sim_bridge)
    if vx == 0.0 and vy == 0.0 and wz == 0.0:
        tcp_cmd = bridge.get_latest_cmd_vel(timeout=0.5)
        if tcp_cmd is not None:
            vx, vy, wz = tcp_cmd

    cmd[:] = [vx, vy, wz]


