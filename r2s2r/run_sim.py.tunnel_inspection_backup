# =========================================================
# 10. math utils
# =========================================================
def mat_to_quat(R):
    """3x3 旋转矩阵 → 四元数 (qx, qy, qz, qw).

    Shepperd 4 分支方法: 按 trace / 最大对角元选分支, 保证 s > 0 在任意旋转下
    都数值稳定. 单分支版本仅在 trace > 0 (即 |yaw| < 120° 时, 纯 yaw 下)
    正确, trace ≤ 0 时静默返回 identity, 表现为 "机头朝后 TF 朝前".
    """
    m00, m11, m22 = R[0, 0], R[1, 1], R[2, 2]
    tr = m00 + m11 + m22

    if tr > 0:
        s = math.sqrt(tr + 1.0) * 2.0
        qw = 0.25 * s
        qx = (R[2, 1] - R[1, 2]) / s
        qy = (R[0, 2] - R[2, 0]) / s
        qz = (R[1, 0] - R[0, 1]) / s
    elif m00 > m11 and m00 > m22:
        s = math.sqrt(1.0 + m00 - m11 - m22) * 2.0
        qw = (R[2, 1] - R[1, 2]) / s
        qx = 0.25 * s
        qy = (R[0, 1] + R[1, 0]) / s
        qz = (R[0, 2] + R[2, 0]) / s
    elif m11 > m22:
        s = math.sqrt(1.0 + m11 - m00 - m22) * 2.0
        qw = (R[0, 2] - R[2, 0]) / s
        qx = (R[0, 1] + R[1, 0]) / s
        qy = 0.25 * s
        qz = (R[1, 2] + R[2, 1]) / s
    else:
        s = math.sqrt(1.0 + m22 - m00 - m11) * 2.0
        qw = (R[1, 0] - R[0, 1]) / s
        qx = (R[0, 2] + R[2, 0]) / s
        qy = (R[1, 2] + R[2, 1]) / s
        qz = 0.25 * s

    return qx, qy, qz, qw


def get_pose():
    """
    返回 body link 在世界系的 4x4 位姿.
    仿真中 odin1_base_link ≡ body link, lidar1/imu_link 通过 bridge_node
    静态 TF 表达物理偏移 (与真机几何拓扑一致, 高度由 spot body 决定).
    """
    if not body_prim.IsValid():
        return None

    xform = UsdGeom.Imageable(body_prim).ComputeLocalToWorldTransform(
        Usd.TimeCode.Default()
    )

    mat = np.array(xform).T
    return mat


