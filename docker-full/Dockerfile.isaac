# ========================================
# Isaac Sim Docker — Isaac Real2Sim2Real
# ========================================
FROM nvcr.io/nvidia/isaac-sim:5.1.0

# Isaac Sim 自带 Python 位于 /isaac-sim/kit/python/bin/python3
# 额外依赖 (numpy, pyyaml 已内置)
RUN /isaac-sim/kit/python/bin/python3 -m pip install --no-cache-dir msgpack opencv-python-headless

# 复制项目代码 (bind mount 可在运行时覆盖)
WORKDIR /workspace
COPY r2s2r/ /workspace/r2s2r/
COPY lidar_configs/ /workspace/lidar_configs/

COPY --chmod=755 docker-full/entrypoint_isaac.sh /entrypoint_isaac.sh

ENTRYPOINT ["/entrypoint_isaac.sh"]
CMD ["/isaac-sim/python.sh", "/workspace/r2s2r/run_sim.py", "--config", "/workspace/r2s2r/configs/config.yaml"]
