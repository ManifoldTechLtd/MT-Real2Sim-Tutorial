# ========================================
# ROS1 Noetic Docker — Isaac Real2Sim2Real
# ========================================
FROM ros:noetic-perception

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake git python3-pip python3-catkin-tools \
    ros-noetic-rviz ros-noetic-rqt-rviz ros-noetic-tf \
    ros-noetic-pcl-ros ros-noetic-pcl-conversions \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir msgpack numpy pyyaml

WORKDIR /catkin_ws
COPY ros1_ws/src /catkin_ws/src

RUN /bin/bash -c "source /opt/ros/noetic/setup.bash && catkin_make -DCMAKE_BUILD_TYPE=Release"

COPY --chmod=755 docker-full/entrypoint_ros1.sh /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
