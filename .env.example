# Isaac Navigation Sim 环境变量配置示例
# 复制为 .env 并根据需要修改

# 场景文件目录
DATASET_DIR=/home/mt/dzy/tunnel-inspection-v2/dataset

# 机器人类型（可选，默认使用 config.yaml 中的配置）
# ROBOT_TYPE=kinematic_car
# ROBOT_TYPE=spot
# ROBOT_TYPE=go2

# 场景文件路径（可选，覆盖 config.yaml）
# SCENE_PATH=/dataset/tunnel1.usdz

# 显示设置
DISPLAY=${DISPLAY}

# Isaac Sim 启动超时（秒）
# 首次启动建议设置为 1800
# MAX_WAIT=600
