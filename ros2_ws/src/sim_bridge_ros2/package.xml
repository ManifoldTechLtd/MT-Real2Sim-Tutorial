<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sim_bridge_ros2</name>
  <version>0.1.0</version>
  <description>
    Isaac Sim TCP(9090) 与 ROS2 的双向桥（移植自 MT-Real2Sim 的 ROS1 sim_bridge）。
    发布 /state_estimation、/registered_scan、/imu/data、/camera/image/compressed 与 TF；
    订阅 /cmd_vel、/sim_reset。话题与 TF 语义与 ROS1 版完全一致，保证算法双线共用同一仿真。
  </description>
  <maintainer email="yuhaowen@manifoldtech.cn">Manifold Tech Ltd.</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
