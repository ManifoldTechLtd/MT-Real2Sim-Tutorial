<launch>
  <!-- Teleop only: bridge + keyboard -->
  <arg name="tcp_host" default="localhost"/>
  <arg name="tcp_port" default="9090"/>
  <arg name="rviz" default="true"/>

  <!-- TCP Bridge -->
  <include file="$(find sim_bridge)/launch/bridge.launch">
    <arg name="tcp_host" value="$(arg tcp_host)"/>
    <arg name="tcp_port" value="$(arg tcp_port)"/>
  </include>

  <!-- Keyboard Teleop -->
  <node pkg="nav_demo" type="teleop_keyboard.py" name="teleop_keyboard" output="screen">
    <param name="linear_speed" value="1.5"/>
    <param name="lateral_speed" value="1.0"/>
    <param name="angular_speed" value="1.5"/>
  </node>

  <!-- RViz -->
  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz"
        args="-d $(find nav_demo)/rviz/default.rviz" output="screen"/>
</launch>
