<?xml version="1.0"?>
<launch>
  <!-- AL-iLQR Go2 Local Planner -->

  <!-- Arguments -->
  <arg name="config_file" default="$(find al_ilqr_go2)/config/al_ilqr_go2.yaml"/>
  <arg name="odometry_topic" default="/odin1/odometry"/>
  <arg name="global_path_topic" default="/initial_path"/>
  <arg name="cmd_vel_topic" default="/cmd_vel"/>
  <arg name="scan_topic" default="/scan"/>
  <!-- 道路边界约束开关：绝对坐标系 y 向走廊（非真车道线），默认禁用 -->
  <arg name="enable_road_boundary" default="false"/>

  <!-- AL-iLQR Node -->
  <node pkg="al_ilqr_go2" type="al_ilqr_go2_node" name="al_ilqr_go2_node" output="screen">
    <!-- Load parameters into node's private namespace (~) -->
    <rosparam file="$(arg config_file)" command="load"/>

    <!-- 放在 rosparam load 之后，确保覆盖 yaml 中的同名参数 -->
    <param name="planning/enable_road_boundary" value="$(arg enable_road_boundary)"/>
    <!-- 一键切换激光源（/scan ↔ /scan_360）：动态避障订阅的话题名来自
         dynamic_obstacles/scan_topic 参数（而非 remap），这里用同一个 arg
         同时覆盖监控话题与动态避障话题，保证只改 scan_topic 一处即可 -->
    <param name="scan_topic" value="$(arg scan_topic)"/>
    <param name="dynamic_obstacles/scan_topic" value="$(arg scan_topic)"/>

    <!-- Topic remapping -->
    <remap from="/odin1/odometry" to="$(arg odometry_topic)"/>
    <remap from="/initial_path" to="$(arg global_path_topic)"/>
    <remap from="/cmd_vel" to="$(arg cmd_vel_topic)"/>
    <remap from="/scan" to="$(arg scan_topic)"/>
  </node>
</launch>
