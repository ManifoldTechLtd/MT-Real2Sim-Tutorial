<?xml version="1.0"?>
<package format="2">
  <name>al_ilqr_ros</name>
  <version>0.1.0</version>
  <description>
    ROS wrapper for the AL-iLQR-Pro core library.
    Wraps the pure C++ augmented-Lagrangian iLQR solver into a catkin
    package suitable for Jetson NX / ROS Noetic deployment.
  </description>

  <maintainer email="todo@todo.todo">TODO</maintainer>
  <license>TODO</license>

  <buildtool_depend>catkin</buildtool_depend>

  <!-- ROS message / library dependencies -->
  <depend>roscpp</depend>
  <depend>std_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>pcl_ros</depend>
  <depend>eigen_conversions</depend>

  <!-- External (non-catkin) dependency -->
  <build_depend>libeigen3-dev</build_depend>

  <export>
  </export>
</package>
