<launch>
  <node name="al_ilqr_planner" pkg="al_ilqr_ros" type="al_ilqr_ros_node" output="screen">
    <rosparam file="$(find al_ilqr_ros)/config/al_ilqr_params.yaml" command="load"/>
    <param name="odom_topic" value="/odin1/odometry"/>
    <param name="path_topic" value="/map_planner/global_path"/>
    <param name="scan_topic" value="/scan"/>
    <param name="cmd_vel_topic" value="/cmd_vel"/>
    <param name="base_frame" value="odin1_base_link"/>
    <param name="odom_frame" value="odom"/>
  </node>
</launch>
